# Backend environment. Copy to server/.env and fill locally. Never commit server/.env.
PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true only when the API is behind a trusted reverse proxy.
TRUST_PROXY=false

# MongoDB Atlas (optional). Leave blank for explicit non-persistent memory mode.
# Example placeholder: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=tempu_tracker
# If true, tracking endpoints return 503 when MongoDB is configured but unavailable.
# If false, the backend starts in an explicitly labelled memory-fallback mode.
MONGODB_REQUIRED=false

# Meta Model API. Keep this key on the backend only.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
# Chat model is pinned in server/config.ts (CHAT_MODEL). META_MODEL is listed
# here for documentation only and is intentionally ignored at runtime.
META_MODEL=muse-spark-1.2-contributor
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2000

# Tracking privacy and freshness controls.
TRACKING_STALE_SECONDS=30
TRACKING_SESSION_TTL_SECONDS=3600
LOCATION_MIN_INTERVAL_MS=3000
